{
  "name": "bot-liga-el-desafio",
  "productName": "El Desafío Organizador",
  "version": "3.0.0",
  "private": true,
  "description": "App de los organizadores de la Liga El Desafío: panel de la liga, sorteos, pantalla de la TV y bot de WhatsApp",
  "author": "Diego Bahamondez",
  "main": "main.js",
  "scripts": {
    "preparar": "node scripts/preparar.js",
    "start": "npm run preparar && electron .",
    "empaquetar": "npm run preparar && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "cl.eldesafio.bot",
    "productName": "El Desafío Organizador",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-tv.js",
      "ui/**",
      "bot/**",
      "web/**",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "El Desafío Organizador",
      "artifactName": "Instalar-El-Desafio-Organizador.exe",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": null
  },
  "repository": "https://github.com/dibahamondez/liga-el-desafio"
}